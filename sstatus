#!/usr/bin/env python3
"""
This script summarizes the occupancy of the compute nodes available in the
SLURM cluster by partition or individual nodes.
"""

import argparse
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass, field

# table width to assume when the terminal size can't be determined
FALLBACK_WIDTH = 80
# minimum width of the coloured part of a bar
MIN_BAR_WIDTH = 10
# a data center server rarely holds more than 8 cards, so a shorter bar will do
MIN_GPU_BAR_WIDTH = 8
# column separator
SEP = " | "
# matches ANSI escape sequences, needed to measure the printable width of a string
ANSI_PATTERN = re.compile(r"\033\[[0-9;]*m")


class Colours:
    # Basic colors
    RED = "\033[41m"      # Red background
    ORANGE = "\033[43m"   # Yellow background for orange-like effect
    GREEN = "\033[42m"    # Green background
    BLUE = "\033[44m"     # Blue background for additional variety
    PURPLE = "\033[45m"   # Magenta background for purple effect
    CYAN = "\033[46m"     # Cyan background
    NONE = "\033[0m"      # Reset

    # High-intensity colors
    LIGHT_RED = "\033[101m"    # Bright red background
    LIGHT_GREEN = "\033[102m"  # Bright green background
    LIGHT_YELLOW = "\033[103m" # Bright yellow background
    LIGHT_BLUE = "\033[104m"   # Bright blue background
    LIGHT_PURPLE = "\033[105m" # Bright magenta background
    LIGHT_CYAN = "\033[106m"   # Bright cyan background

    @classmethod
    def disable(cls):
        """Replaces every colour code with an empty string."""
        for name in [n for n in vars(cls) if n.isupper()]:
            setattr(cls, name, "")


@dataclass
class Node:
    """
    Represents information about a node in a Slurm cluster.
    """
    name: str
    partitions: list = field(default_factory=list)
    mem_total: int = 0
    mem_used: int = 0
    cpu_total: int = 0
    cpu_used: int = 0
    gpu_total: int = 0  # Default to 0 to indicate no GPU
    gpu_used: int = 0
    os_factor: int = 1
    unavailable: bool = False # for marking whether nodes are unavailable, i.e. NOT rebooting, completing, failing etc...

    @property
    def partition(self):
        """All partitions the node belongs to as a single string."""
        return ",".join(self.partitions)


def run_slurm(command):
    """
    Runs a SLURM command and returns its output, exiting with a readable
    message instead of a traceback if the command is missing or fails.
    """
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.exit(f"error: '{command[0]}' not found, is SLURM installed and in PATH?")
    except subprocess.CalledProcessError as error:
        sys.exit(f"error: '{' '.join(command)}' failed:\n{error.stderr.strip()}")
    return result.stdout


def visible_width(text):
    """
    Returns the printable width of a string, ignoring ANSI escape sequences.
    """
    return len(ANSI_PATTERN.sub("", text))


def pad(text, width, align="<"):
    """
    Pads a string (which may contain ANSI escape sequences) to `width`.
    """
    padding = " " * max(0, width - visible_width(text))
    if align == ">":
        return padding + text
    if align == "^":
        left = len(padding) // 2
        return padding[:left] + text + padding[left:]
    return text + padding


def colour_thres(fraction):
    """
    Returns a color code corresponding to a fraction between 0 and 1
    according to thresholds set in this function.
    """
    if fraction <= .4:
        return Colours.GREEN
    elif fraction <= .8:
        return Colours.ORANGE
    elif fraction < 1:
        return Colours.RED
    else:
        return Colours.PURPLE


def in_gb(num_mb):
    """
    Returns a number of megabytes in gigabytes, rounded down to nearest
    gigabyte.
    """
    return int(num_mb / 1024)


def create_bar(used, total, bar_width, free_width, total_width):
    """
    Creates a colorized bar based on the fraction of used and total capacity,
    including the allocated value displayed on the bar. The result is exactly
    `free_width + 1 + bar_width + 1 + total_width` characters wide when printed.
    """
    fraction = used / total if total > 0 else 0
    colour = colour_thres(fraction)
    label = f"{used}".ljust(bar_width)
    filled = min(bar_width, max(0, round(bar_width * fraction)))
    bar = f"{colour}{label[:filled]}{Colours.NONE}{label[filled:]}"
    return f"{total - used:>{free_width}} {bar}/{total:<{total_width}}"


class ResourceColumn:
    """
    A table column holding used/total pairs rendered as bars. The widths of the
    free, allocated and total parts are derived from the values it holds, so
    the column is only ever as wide as it needs to be.
    """

    def __init__(self, header, weight=1.0, min_bar=MIN_BAR_WIDTH):
        self.header = header
        self.weight = weight
        self.min_bar = min_bar
        self.values = []
        self.free_width = 1
        self.total_width = 1
        self.bar_width = min_bar

    def add(self, used, total):
        """Adds a cell, or an empty cell if the resource is not available."""
        self.values.append((used, total) if total > 0 else None)

    @property
    def used(self):
        """Whether any row in this column has something to show."""
        return any(value is not None for value in self.values)

    def measure(self):
        """
        Fixes the width of the numbers around the bar and returns the minimum
        total width of the column.
        """
        cells = [value for value in self.values if value is not None] or [(0, 0)]
        self.free_width = max(len(f"{total - used}") for used, total in cells)
        self.total_width = max(len(f"{total}") for used, total in cells)
        # the bar has to fit the allocated value that is printed on top of it
        min_bar = max(self.min_bar, max(len(f"{used}") for used, total in cells))
        return max(len(self.header), self.overhead + min_bar)

    @property
    def overhead(self):
        """Width of everything in a cell except the bar itself."""
        return self.free_width + self.total_width + 2

    def render(self, index):
        """Renders row `index`, padded to the full column width."""
        value = self.values[index]
        if value is None:
            return " " * self.width
        return create_bar(*value, self.bar_width, self.free_width, self.total_width)

    @property
    def width(self):
        return self.overhead + self.bar_width


@dataclass
class Row:
    """A single line of the table: some text labels and a set of resources."""
    labels: list
    flag: str = " "


def print_table(label_headers, rows, columns, total_label, total_width):
    """
    Prints a table of resource bars. All column widths are derived from the
    content, and the bars then grow to fill `total_width` characters. Pass a
    `total_width` of 0 to keep the table at its minimum width.

    `rows` holds one Row per line plus a final one for the totals, and every
    ResourceColumn in `columns` holds exactly one value per row.
    """
    columns = [column for column in columns if column.used]
    label_widths = [
        max([len(header)] + [len(row.labels[i]) for row in rows[:-1]])
        for i, header in enumerate(label_headers)
    ]
    # the flag is printed right after the first label, so widen that column
    flag_width = 1 if any(row.flag.strip() for row in rows) else 0
    label_widths[0] += flag_width
    # the labels of the totals row are replaced by a single label spanning them all
    label_span = max(
        sum(label_widths) + len(SEP) * (len(label_widths) - 1),
        len(total_label),
    )

    # grow the bars so the table fills the available width
    min_widths = [column.measure() for column in columns]
    fixed_width = label_span + sum(len(SEP) + width for width in min_widths)
    extra = max(0, total_width - fixed_width)
    total_weight = sum(column.weight for column in columns)
    shares = [int(extra * column.weight / total_weight) for column in columns]
    # hand any rounding remainder to the first column
    shares[0] += extra - sum(shares)
    for column, min_width, share in zip(columns, min_widths, shares):
        column.bar_width = min_width - column.overhead + share

    table_width = label_span + sum(len(SEP) + column.width for column in columns)
    header = pad(
        SEP.join(pad(header, width) for header, width in zip(label_headers, label_widths)),
        label_span,
    )
    header += "".join(SEP + pad(column.header, column.width, "^") for column in columns)
    print(header)
    print("=" * table_width)

    for index, row in enumerate(rows):
        if index == len(rows) - 1:
            print("-" * table_width)
            labels = pad(total_label, label_span)
        else:
            cells = [pad(label, width) for label, width in zip(row.labels, label_widths)]
            if flag_width:
                cells[0] = pad(row.labels[0], label_widths[0] - flag_width) + row.flag
            labels = pad(SEP.join(cells), label_span)
        print(labels + "".join(SEP + column.render(index) for column in columns))


def parse_partitions(scontrol_output):
    """
    Parses `scontrol show partition` into a dict of partition name to its
    settings, in the order they are defined in slurm.conf.
    """
    partitions = {}
    current = None
    for line in scontrol_output.splitlines():
        name_match = re.search(r"PartitionName=(\S+)", line)
        if name_match:
            current = name_match.group(1)
            partitions[current] = {"os_factor": 1}
            continue
        if current is None:
            continue
        oversubscribe_match = re.search(r"OverSubscribe=FORCE:(\d+)", line)
        if oversubscribe_match:
            partitions[current]["os_factor"] = int(oversubscribe_match.group(1))
    return partitions


def parse_nodes(scontrol_output, partitions):
    """
    Parses `scontrol show node` into a list of Node objects.
    """
    # list of keywords in the node state that trigger an 'unavailable' status
    unavailable_keywords = [
        "blocked",
        "down",
        "drain",
        "drained",
        "draining",
        "fail",
        "failing",
        "future",
        "inval",
        "maint",
        "reboot_issued",
        "reboot_requested",
        "perfctrs",
        "noresp",
        "power_up",
        "power_down",
        "powered_down",
        "powering_down",
        "powering_up",
        "reserved",
        "unknown",
    ]

    nodes = []
    node = None
    for line in scontrol_output.splitlines():
        line = line.lstrip()
        if line.startswith("NodeName="):
            # SLURM doesn't report the number of allocated CPUs on partitions
            # with over-subscribe configured, but getting it from squeue instead
            # counts CPUs twice for jobs allocated more than one node, so stick
            # to the output of "scontrol show node".
            node = Node(re.search(r"(?<=NodeName=)\S+", line).group())
            nodes.append(node)
        elif node is None:
            continue

        elif line.startswith("Partitions="):
            node.partitions = re.search(r"(?<=Partitions=)(\S+)", line).group(1).split(",")
            # a node can be in several partitions, use the most permissive factor
            node.os_factor = max(
                (partitions.get(name, {}).get("os_factor", 1) for name in node.partitions),
                default=1,
            )

        elif line.startswith("State="):
            state = re.search(r"(?<=State=)\S+", line).group().lower()
            node.unavailable = any(keyword in state for keyword in unavailable_keywords)

        elif line.startswith("CPUAlloc="):
            node.cpu_used = int(re.search(r"(?<=CPUAlloc=)[0-9]+", line).group())
            node.cpu_total = int(re.search(r"(?<=CPUTot=)[0-9]+", line).group())

        elif line.startswith("RealMemory="):
            node.mem_used = int(re.search(r"(?<=AllocMem=)[0-9]+", line).group())
            node.mem_total = int(re.search(r"(?<=RealMemory=)[0-9]+", line).group())

        elif line.startswith("CfgTRES="):
            gpu_match = re.search(r"(?<=gres/gpu=)[0-9]+", line)
            if gpu_match:
                node.gpu_total = int(gpu_match.group())

        elif line.startswith("AllocTRES="):
            gpu_match = re.search(r"(?<=gres/gpu=)[0-9]+", line)
            if gpu_match:
                node.gpu_used = int(gpu_match.group())

    return nodes


def sum_resources(nodes, os_factor=None):
    """
    Adds up the resources of a group of nodes, taking over-subscription of the
    CPUs into account. `os_factor` overrides the factor stored on the nodes,
    which is needed for nodes that are shared between several partitions.
    """
    return {
        "cpu_used": sum(node.cpu_used for node in nodes),
        "cpu_total": sum(node.cpu_total * (os_factor or node.os_factor) for node in nodes),
        "mem_used": sum(node.mem_used for node in nodes),
        "mem_total": sum(node.mem_total for node in nodes),
        "gpu_used": sum(node.gpu_used for node in nodes),
        "gpu_total": sum(node.gpu_total for node in nodes),
    }


def print_partition_summary(partitions, partition_nodes, cluster_totals, total_width):
    rows = []
    cpus = ResourceColumn("CPUs")
    memory = ResourceColumn("Memory (GB)")
    gpus = ResourceColumn("GPUs", weight=0.4, min_bar=MIN_GPU_BAR_WIDTH)

    for partition, nodes in partition_nodes.items():
        os_factor = partitions.get(partition, {}).get("os_factor", 1)
        totals = sum_resources(nodes, os_factor)
        label = f"{partition} ({os_factor}x)" if os_factor > 1 else partition
        rows.append(Row([label]))
        cpus.add(totals["cpu_used"], totals["cpu_total"])
        memory.add(in_gb(totals["mem_used"]), in_gb(totals["mem_total"]))
        gpus.add(totals["gpu_used"], totals["gpu_total"])

    rows.append(Row(["Total:"]))
    cpus.add(cluster_totals["cpu_used"], cluster_totals["cpu_total"])
    memory.add(in_gb(cluster_totals["mem_used"]), in_gb(cluster_totals["mem_total"]))
    gpus.add(cluster_totals["gpu_used"], cluster_totals["gpu_total"])

    print_table(["Partition"], rows, [cpus, memory, gpus], "Total:", total_width)


def print_node_summary(nodes, cluster_totals, total_width):
    rows = []
    cpus = ResourceColumn("CPUs")
    memory = ResourceColumn("Memory (GB)")
    gpus = ResourceColumn("GPUs", weight=0.4, min_bar=MIN_GPU_BAR_WIDTH)

    for node in nodes:
        rows.append(Row([node.name, node.partition], flag="*" if node.unavailable else " "))
        cpus.add(node.cpu_used, node.cpu_total * node.os_factor)
        memory.add(in_gb(node.mem_used), in_gb(node.mem_total))
        gpus.add(node.gpu_used, node.gpu_total)

    rows.append(Row(["Total:", ""]))
    cpus.add(cluster_totals["cpu_used"], cluster_totals["cpu_total"])
    memory.add(in_gb(cluster_totals["mem_used"]), in_gb(cluster_totals["mem_total"]))
    gpus.add(cluster_totals["gpu_used"], cluster_totals["gpu_total"])

    print_table(["Node", "Partition"], rows, [cpus, memory, gpus], "Total:", total_width)

    if any(node.unavailable for node in nodes):
        print("\n* node is unavailable (down, drained, reserved, ...)")


def print_jobs_summary():
    states = run_slurm(["squeue", "-rh", "-o", "%t"]).split()
    print("Jobs running/queued/total:")
    print(f"  {states.count('R')} / {states.count('PD')} / {len(states)}")


def print_reservations_summary():
    reservations = run_slurm(["sinfo", "-Th"]).strip()
    # sinfo prints "No reservations in the system" when there are none
    if not reservations or "No reservations" in reservations:
        return
    states = [line.split()[1] for line in reservations.splitlines() if len(line.split()) > 1]
    print()
    print("Reservations active/total:")
    print(f"  {states.count('ACTIVE')} / {len(states)}")


def parse_time_to_hours(time_str):
    """
    Parses a Slurm TIME_LEFT string into total hours. Returns 0 for values that
    don't hold a duration, such as UNLIMITED, INVALID or N/A.
    """
    # valid formats are MM:SS, HH:MM:SS, D-HH, D-HH:MM and D-HH:MM:SS
    if not re.fullmatch(r"\d+(-\d{1,2}(:\d{2}){0,2}|(:\d{2}){1,2})", time_str or ""):
        return 0.0

    days = 0
    if "-" in time_str:
        days_str, time_str = time_str.split("-")
        days = int(days_str)
        # after a day count the time always starts at the hours
        hours, minutes, seconds = ([int(part) for part in time_str.split(":")] + [0, 0])[:3]
    else:
        parts = [int(part) for part in time_str.split(":")]
        hours, minutes, seconds = parts if len(parts) == 3 else [0] + parts

    return (days * 24) + hours + (minutes / 60.0) + (seconds / 3600.0)


def extract_gpu_count(gres_str):
    """
    Extracts the number of GPUs from strings like 'gpu:2', 'gpu:tesla:4', or '(null)'.
    """
    if not gres_str or "gpu" not in gres_str.lower():
        return 0
    # Search for the last digit in the gpu string (e.g., gpu:tesla:2 -> 2)
    match = re.search(r"gpu[:\w]*:(\d+)", gres_str.lower())
    return int(match.group(1)) if match else 0


def format_tres_hours(hours):
    """Formats hours with K/M suffixes."""
    if hours >= 1_000_000:
        return f"{hours / 1_000_000:.1f}M"
    elif hours >= 1_000:
        return f"{hours / 1_000:.1f}K"
    else:
        return f"{hours:,.1f}"


def print_queued_tres_hours():
    """Calculates queued CPU and GPU hours using a single squeue call."""
    # %l=TimeLeft, %c=CPUs, %b=tres (%b is undocumented in the squeue manpage!)
    squeue_output = run_slurm(["squeue", "-rh", "-tPD", "-o", "%l %c %b"]).strip()
    if not squeue_output:
        return

    total_cpu_hours = 0.0
    total_gpu_hours = 0.0
    total_cpus = 0
    total_gpus = 0

    for line in squeue_output.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue

        # Parse Time and CPUs (always present)
        time_hours = parse_time_to_hours(parts[0])
        cpu_count = int(parts[1])

        # Parse GPUs (GRES column might be empty or (null))
        gpu_count = extract_gpu_count(parts[2] if len(parts) > 2 else "")

        # Accumulate Totals
        total_cpus += cpu_count
        total_gpus += gpu_count
        total_cpu_hours += time_hours * cpu_count
        total_gpu_hours += time_hours * gpu_count

    # Only print if there is at least one resource type queued
    if total_cpus > 0 or total_gpus > 0:
        print()
        print("Total resources requested from queued jobs:")
        if total_cpus > 0:
            print(f"  CPUs: {total_cpus} ({format_tres_hours(total_cpu_hours)} CPU hours)")
        if total_gpus > 0:
            print(f"  GPUs: {total_gpus} ({format_tres_hours(total_gpu_hours)} GPU hours)")


def parse_args():
    parser = argparse.ArgumentParser(
        description="Displays a SLURM cluster allocation summary by partition or per node. https://github.com/KasperSkytte/sstatus"
    )
    parser.add_argument(
        "-n", "--nodes", action="store_true",
        help="show per-node status instead of by partition."
    )
    width = parser.add_mutually_exclusive_group()
    width.add_argument(
        "-w", "--width", type=int, metavar="COLUMNS",
        help="fill this many columns instead of the terminal width."
    )
    width.add_argument(
        "-c", "--compact", action="store_true",
        help="don't stretch the table to fill the window, only print it as wide as its contents require."
    )
    parser.add_argument(
        "--no-colour", "--no-color", dest="colour", action="store_false",
        help="don't colourize the bars."
    )
    return parser.parse_args()


def main():
    args = parse_args()
    if not args.colour:
        Colours.disable()

    # a width of 0 leaves the table at the minimum width its contents need
    if args.compact:
        total_width = 0
    else:
        total_width = args.width or shutil.get_terminal_size(fallback=(FALLBACK_WIDTH, 24)).columns

    partitions = parse_partitions(run_slurm(["scontrol", "show", "partition"]))
    nodes = parse_nodes(run_slurm(["scontrol", "show", "node"]), partitions)
    if not nodes:
        sys.exit("error: no nodes reported by 'scontrol show node'.")

    # group nodes by partition, keeping the partition order from slurm.conf
    partition_nodes = {name: [] for name in partitions}
    for node in nodes:
        for name in node.partitions:
            partition_nodes.setdefault(name, []).append(node)
    partition_nodes = {name: group for name, group in partition_nodes.items() if group}

    # a node can be in several partitions, so total over the nodes themselves
    cluster_totals = sum_resources(nodes)

    print("Cluster allocation summary per partition or individual nodes (-n).")
    print("(Numbers are reported in free/allocated/total).\n")
    if args.nodes:
        # sort by partition order first, then by node name
        partition_order = list(partition_nodes)
        nodes.sort(key=lambda node: (
            min((partition_order.index(name) for name in node.partitions), default=len(partition_order)),
            node.name,
        ))
        print_node_summary(nodes, cluster_totals, total_width)
    else:
        print_partition_summary(partitions, partition_nodes, cluster_totals, total_width)
    print_queued_tres_hours()
    print()
    print_jobs_summary()
    print_reservations_summary()
    print()
    print("Use sinfo or squeue to obtain more details.")


if __name__ == "__main__":
    main()
