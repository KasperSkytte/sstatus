#!/usr/bin/env python3
"""
This script summarizes the occupancy of the compute nodes available in the
SLURM cluster by partition or individual nodes.
"""

import argparse
import re
import subprocess
import sys
from dataclasses import dataclass, field

bar_width = 20

class Colours:
    # Basic colors
    RED = "\033[41m"      # Red background
    ORANGE = "\033[43m"   # Yellow background for orange-like effect
    GREEN = "\033[42m"    # Green background
    BLUE = "\033[44m"     # Blue background for additional variety
    PURPLE = "\033[45m"   # Magenta background for purple effect
    CYAN = "\033[46m"     # Cyan background
    NONE = "\033[0m"      # Reset

    # High-intensity colors
    LIGHT_RED = "\033[101m"    # Bright red background
    LIGHT_GREEN = "\033[102m"  # Bright green background
    LIGHT_YELLOW = "\033[103m" # Bright yellow background
    LIGHT_BLUE = "\033[104m"   # Bright blue background
    LIGHT_PURPLE = "\033[105m" # Bright magenta background
    LIGHT_CYAN = "\033[106m"   # Bright cyan background

@dataclass
class Node:
    """
    Represents information about a node in a Slurm cluster.
    """
    name: str
    partitions: list = field(default_factory=list)
    mem_total: int = 0
    mem_used: int = 0
    cpu_total: int = 0
    cpu_used: int = 0
    gpu_total: int = 0  # Default to 0 to indicate no GPU
    gpu_used: int = 0
    os_factor: int = 1
    unavailable: bool = False # for marking whether nodes are unavailable, i.e. NOT rebooting, completing, failing etc...

    @property
    def partition(self):
        """All partitions the node belongs to as a single string."""
        return ",".join(self.partitions)


def run_slurm(command):
    """
    Runs a SLURM command and returns its output, exiting with a readable
    message instead of a traceback if the command is missing or fails.
    """
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.exit(f"error: '{command[0]}' not found, is SLURM installed and in PATH?")
    except subprocess.CalledProcessError as error:
        sys.exit(f"error: '{' '.join(command)}' failed:\n{error.stderr.strip()}")
    return result.stdout


def colour_thres(fraction):
    """
    Returns a color code corresponding to a fraction between 0 and 1
    according to thresholds set in this function.
    """
    if fraction <= .4:
        return Colours.GREEN
    elif fraction <= .8:
        return Colours.ORANGE
    elif fraction < 1:
        return Colours.RED
    else:
        return Colours.PURPLE

def in_gb(num_mb):
    """
    Returns a number of megabytes in gigabytes, rounded down to nearest
    gigabyte.
    """
    return int(num_mb / 1024)

def str_insert(piece, text, pos):
    """
    Inserts `piece` into `text` at position `pos`.
    """
    return text[:pos] + piece + text[pos:]

def create_bar(used, total, bar_width = bar_width, free_width = 5, total_width = 5):
    """
    Creates a colorized bar based on the fraction of used and total capacity,
    including the allocated value displayed on the bar.
    """
    fraction = used / total if total > 0 else 0
    color = colour_thres(fraction)
    padded_bar = f"{used}".ljust(bar_width)
    bar = str_insert(Colours.NONE, padded_bar, round(bar_width * fraction))
    return f"{total-used:>{int(free_width)}} {color}{bar}{Colours.NONE}/{total:<{int(total_width)}}"


def parse_partitions(scontrol_output):
    """
    Parses `scontrol show partition` into a dict of partition name to its
    settings, in the order they are defined in slurm.conf.
    """
    partitions = {}
    current = None
    for line in scontrol_output.splitlines():
        name_match = re.search(r"PartitionName=(\S+)", line)
        if name_match:
            current = name_match.group(1)
            partitions[current] = {"os_factor": 1}
            continue
        if current is None:
            continue
        oversubscribe_match = re.search(r"OverSubscribe=FORCE:(\d+)", line)
        if oversubscribe_match:
            partitions[current]["os_factor"] = int(oversubscribe_match.group(1))
    return partitions


def parse_nodes(scontrol_output, partitions):
    """
    Parses `scontrol show node` into a list of Node objects.
    """
    # list of keywords in the node state that trigger an 'unavailable' status
    unavailable_keywords = [
        "blocked",
        "down",
        "drain",
        "drained",
        "draining",
        "fail",
        "failing",
        "future",
        "inval",
        "maint",
        "reboot_issued",
        "reboot_requested",
        "perfctrs",
        "noresp",
        "power_up",
        "power_down",
        "powered_down",
        "powering_down",
        "powering_up",
        "reserved",
        "unknown",
    ]

    nodes = []
    node = None
    for line in scontrol_output.splitlines():
        line = line.lstrip()
        if line.startswith("NodeName="):
            # SLURM doesn't report the number of allocated CPUs on partitions
            # with over-subscribe configured, but getting it from squeue instead
            # counts CPUs twice for jobs allocated more than one node, so stick
            # to the output of "scontrol show node".
            node = Node(re.search(r"(?<=NodeName=)\S+", line).group())
            nodes.append(node)
        elif node is None:
            continue

        elif line.startswith("Partitions="):
            node.partitions = re.search(r"(?<=Partitions=)(\S+)", line).group(1).split(",")
            # a node can be in several partitions, use the most permissive factor
            node.os_factor = max(
                (partitions.get(name, {}).get("os_factor", 1) for name in node.partitions),
                default=1,
            )

        elif line.startswith("State="):
            state = re.search(r"(?<=State=)\S+", line).group().lower()
            node.unavailable = any(keyword in state for keyword in unavailable_keywords)

        elif line.startswith("CPUAlloc="):
            node.cpu_used = int(re.search(r"(?<=CPUAlloc=)[0-9]+", line).group())
            node.cpu_total = int(re.search(r"(?<=CPUTot=)[0-9]+", line).group())

        elif line.startswith("RealMemory="):
            node.mem_used = int(re.search(r"(?<=AllocMem=)[0-9]+", line).group())
            node.mem_total = int(re.search(r"(?<=RealMemory=)[0-9]+", line).group())

        elif line.startswith("CfgTRES="):
            gpu_match = re.search(r"(?<=gres/gpu=)[0-9]+", line)
            if gpu_match:
                node.gpu_total = int(gpu_match.group())

        elif line.startswith("AllocTRES="):
            gpu_match = re.search(r"(?<=gres/gpu=)[0-9]+", line)
            if gpu_match:
                node.gpu_used = int(gpu_match.group())

    return nodes


def sum_resources(nodes, os_factor=None):
    """
    Adds up the resources of a group of nodes, taking over-subscription of the
    CPUs into account. `os_factor` overrides the factor stored on the nodes,
    which is needed for nodes that are shared between several partitions.
    """
    return {
        "cpu_used": sum(node.cpu_used for node in nodes),
        "cpu_total": sum(node.cpu_total * (os_factor or node.os_factor) for node in nodes),
        "mem_used": sum(node.mem_used for node in nodes),
        "mem_total": sum(node.mem_total for node in nodes),
        "gpu_used": sum(node.gpu_used for node in nodes),
        "gpu_total": sum(node.gpu_total for node in nodes),
    }


def print_partition_summary(partitions, partition_nodes, cluster_totals):
    print(f"{'Partition':<11} | {'CPUs':^30} | {'Memory (GB)':^32} | {'GPUs':^11}|")
    print("==============================================================================================")

    for partition, nodes in partition_nodes.items():
        os_factor = partitions.get(partition, {}).get("os_factor", 1)
        totals = sum_resources(nodes, os_factor)
        label = f"{partition} ({os_factor}x)" if os_factor > 1 else partition

        cpu_bar = create_bar(used = totals['cpu_used'], total = totals['cpu_total'], free_width = 4, total_width = 4)
        mem_bar = create_bar(used = in_gb(totals['mem_used']), total = in_gb(totals['mem_total']), bar_width = 20, free_width = 5, total_width = 5)
        gpu_bar = create_bar(used = totals['gpu_used'], total = totals['gpu_total'], bar_width = 8, free_width = 1, total_width = 1) if totals['gpu_total'] > 0 else ""
        print(f"{label:<11} | {cpu_bar:<29} | {mem_bar:<30} | {gpu_bar:^10}")

    total_cpu_bar = create_bar(used = cluster_totals['cpu_used'], total = cluster_totals['cpu_total'], bar_width = 20, free_width = 4, total_width = 4)
    total_mem_bar = create_bar(used = in_gb(cluster_totals['mem_used']), total = in_gb(cluster_totals['mem_total']), bar_width = 20)
    total_gpu_bar = create_bar(used = cluster_totals['gpu_used'], total = cluster_totals['gpu_total'], bar_width = 8, free_width = 1, total_width = 1)

    # print total summary
    print("----------------------------------------------------------------------------------------------")
    print(f"{'Total:':<11} | {total_cpu_bar:<29} | {total_mem_bar:<30} | {total_gpu_bar:^10}")

def print_node_summary(nodes, cluster_totals):
    print(f"{'Node':<10} | {'Partition':<11} | {'CPUs':^30} | {'Memory (GB)':^32} | {'GPUs':^10} |")
    print("===========================================================================================================")

    for node in nodes:
        cpu_bar = create_bar(used = node.cpu_used, total = node.cpu_total * node.os_factor, free_width = 4, total_width = 4)
        mem_bar = create_bar(used = in_gb(node.mem_used), total = in_gb(node.mem_total), free_width = 5, total_width = 5)
        gpu_bar = create_bar(used = node.gpu_used, total = node.gpu_total, bar_width = 8, free_width = 1, total_width = 1) if node.gpu_total > 0 else ""

        print(f"{node.name:<10}{'*' if node.unavailable else ' '}| {node.partition:<11} | {cpu_bar:<31} | {mem_bar:<30} | {gpu_bar:^10}")

    total_cpu_bar = create_bar(used = cluster_totals['cpu_used'], total = cluster_totals['cpu_total'], bar_width = 20, free_width = 4, total_width = 4)
    total_mem_bar = create_bar(used = in_gb(cluster_totals['mem_used']), total = in_gb(cluster_totals['mem_total']), bar_width = 20, free_width = 5, total_width = 5)
    total_gpu_bar = create_bar(used = cluster_totals['gpu_used'], total = cluster_totals['gpu_total'], bar_width = 8, free_width = 1, total_width = 1)

    # print total summary
    print("-----------------------------------------------------------------------------------------------------------")
    print(f"{'Total:':<24} | {total_cpu_bar:<31} | {total_mem_bar:<30} | {total_gpu_bar:^10}")


def print_jobs_summary():
    states = run_slurm(["squeue", "-rh", "-o", "%t"]).split()
    print("Jobs running/queued/total:")
    print(f"  {states.count('R')} / {states.count('PD')} / {len(states)}")


def print_reservations_summary():
    reservations = run_slurm(["sinfo", "-Th"]).strip()
    # sinfo prints "No reservations in the system" when there are none
    if not reservations or "No reservations" in reservations:
        return
    states = [line.split()[1] for line in reservations.splitlines() if len(line.split()) > 1]
    print()
    print("Reservations active/total:")
    print(f"  {states.count('ACTIVE')} / {len(states)}")


def parse_time_to_hours(time_str):
    """
    Parses a Slurm TIME_LEFT string into total hours. Returns 0 for values that
    don't hold a duration, such as UNLIMITED, INVALID or N/A.
    """
    # valid formats are MM:SS, HH:MM:SS, D-HH, D-HH:MM and D-HH:MM:SS
    if not re.fullmatch(r"\d+(-\d{1,2}(:\d{2}){0,2}|(:\d{2}){1,2})", time_str or ""):
        return 0.0

    days = 0
    if "-" in time_str:
        days_str, time_str = time_str.split("-")
        days = int(days_str)
        # after a day count the time always starts at the hours
        hours, minutes, seconds = ([int(part) for part in time_str.split(":")] + [0, 0])[:3]
    else:
        parts = [int(part) for part in time_str.split(":")]
        hours, minutes, seconds = parts if len(parts) == 3 else [0] + parts

    return (days * 24) + hours + (minutes / 60.0) + (seconds / 3600.0)


def extract_gpu_count(gres_str):
    """
    Extracts the number of GPUs from strings like 'gpu:2', 'gpu:tesla:4', or '(null)'.
    """
    if not gres_str or "gpu" not in gres_str.lower():
        return 0
    # Search for the last digit in the gpu string (e.g., gpu:tesla:2 -> 2)
    match = re.search(r"gpu[:\w]*:(\d+)", gres_str.lower())
    return int(match.group(1)) if match else 0


def format_tres_hours(hours):
    """Formats hours with K/M suffixes."""
    if hours >= 1_000_000:
        return f"{hours / 1_000_000:.1f}M"
    elif hours >= 1_000:
        return f"{hours / 1_000:.1f}K"
    else:
        return f"{hours:,.1f}"


def print_queued_tres_hours():
    """Calculates queued CPU and GPU hours using a single squeue call."""
    # %l=TimeLeft, %c=CPUs, %b=tres (%b is undocumented in the squeue manpage!)
    squeue_output = run_slurm(["squeue", "-rh", "-tPD", "-o", "%l %c %b"]).strip()
    if not squeue_output:
        return

    total_cpu_hours = 0.0
    total_gpu_hours = 0.0
    total_cpus = 0
    total_gpus = 0

    for line in squeue_output.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue

        # Parse Time and CPUs (always present)
        time_hours = parse_time_to_hours(parts[0])
        cpu_count = int(parts[1])

        # Parse GPUs (GRES column might be empty or (null))
        gpu_count = extract_gpu_count(parts[2] if len(parts) > 2 else "")

        # Accumulate Totals
        total_cpus += cpu_count
        total_gpus += gpu_count
        total_cpu_hours += time_hours * cpu_count
        total_gpu_hours += time_hours * gpu_count

    # Only print if there is at least one resource type queued
    if total_cpus > 0 or total_gpus > 0:
        print()
        print("Total resources requested from queued jobs:")
        if total_cpus > 0:
            print(f"  CPUs: {total_cpus} ({format_tres_hours(total_cpu_hours)} CPU hours)")
        if total_gpus > 0:
            print(f"  GPUs: {total_gpus} ({format_tres_hours(total_gpu_hours)} GPU hours)")


def parse_args():
    parser = argparse.ArgumentParser(
        description="Displays a SLURM cluster allocation summary by partition or per node. https://github.com/KasperSkytte/sstatus"
    )
    parser.add_argument(
        "-n", "--nodes", action="store_true",
        help="show per-node status instead of by partition."
    )
    return parser.parse_args()


def main():
    args = parse_args()

    partitions = parse_partitions(run_slurm(["scontrol", "show", "partition"]))
    nodes = parse_nodes(run_slurm(["scontrol", "show", "node"]), partitions)
    if not nodes:
        sys.exit("error: no nodes reported by 'scontrol show node'.")

    # group nodes by partition, keeping the partition order from slurm.conf
    partition_nodes = {name: [] for name in partitions}
    for node in nodes:
        for name in node.partitions:
            partition_nodes.setdefault(name, []).append(node)
    partition_nodes = {name: group for name, group in partition_nodes.items() if group}

    # a node can be in several partitions, so total over the nodes themselves
    cluster_totals = sum_resources(nodes)

    print("Cluster allocation summary per partition or individual nodes (-n).")
    print("(Numbers are reported in free/allocated/total).\n")
    if args.nodes:
        # sort by partition order first, then by node name
        partition_order = list(partition_nodes)
        nodes.sort(key=lambda node: (
            min((partition_order.index(name) for name in node.partitions), default=len(partition_order)),
            node.name,
        ))
        print_node_summary(nodes, cluster_totals)
    else:
        print_partition_summary(partitions, partition_nodes, cluster_totals)
    print_queued_tres_hours()
    print()
    print_jobs_summary()
    print_reservations_summary()
    print()
    print("Use sinfo or squeue to obtain more details.")


if __name__ == "__main__":
    main()
